<!-- WpfApp1/Views/LocalModePickerWindow.xaml -->
<Window x:Class="WpfApp1.Views.LocalModePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Action"
        Width="440" Height="560"
        MinHeight="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <!-- Clean ListBox: transparent, no border -->
        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- ListBoxItem: hover + selected highlight -->
        <Style x:Key="PickerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="8" Padding="12,8"
                                Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#16253A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B3050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item DataTemplate: icon + name -->
        <DataTemplate x:Key="PickerItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#6A7A9A"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                           FontSize="13" Foreground="#EAF0FF"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Tab toggle button: Open / Close -->
        <Style x:Key="AppTabStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="#0D1829"
                                BorderBrush="#1A2A40" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#152040"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A6AEE"/>
                                <Setter Property="Foreground" Value="#EAF0FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12203A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#5A6A8A"/>
        </Style>

    </Window.Resources>

    <!-- Outer shadow wrapper -->
    <Border CornerRadius="14" Background="#0B1120"
            BorderBrush="#22344F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>   <!-- header -->
                <RowDefinition Height="44"/>   <!-- search -->
                <RowDefinition Height="*"/>    <!-- content -->
            </Grid.RowDefinitions>

            <!-- ── HEADER ── -->
            <Grid Grid.Row="0" Margin="18,0,12,0"
                  MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Choose Action" FontSize="14" FontWeight="SemiBold"
                               Foreground="#EAF0FF"/>
                    <TextBlock x:Name="SlotLabel" Text="Slot 1" FontSize="11"
                               Foreground="#3A4A6A" Margin="0,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                        VerticalAlignment="Center" Click="CloseBtn_Click"
                        Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Width="28" Height="28"
                                    Background="Transparent">
                                <TextBlock Text="{TemplateBinding Content}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" Foreground="#4A5A7A"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#18253A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Thin divider under header -->
            <Border Grid.Row="0" Height="1" Background="#151F30" VerticalAlignment="Bottom"/>

            <!-- ── SEARCH ── -->
            <Border Grid.Row="1" Margin="14,6,14,2" CornerRadius="9"
                    Background="#0F1929" BorderBrush="#1A2A40" BorderThickness="1">
                <Grid>
                    <TextBlock Text="⌕" FontSize="16" Foreground="#2A3A50"
                               Margin="11,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="#D0DAEF" CaretBrush="#6BD6FF"
                             FontSize="13" Margin="32,0,10,0"
                             VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             FocusVisualStyle="{x:Null}"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="Search actions and apps..."
                               FontSize="13" Foreground="#273040" IsHitTestVisible="False"
                               Margin="34,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── CONTENT ── -->
            <ScrollViewer Grid.Row="2" Margin="0,6,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,0,14,14">

                    <!-- System Functions section -->
                    <StackPanel x:Name="FunctionsSectionPanel">
                        <TextBlock Text="SYSTEM FUNCTIONS" FontSize="9" FontWeight="Bold"
                                   Foreground="#253040" Margin="4,0,0,4"
                                   />
                        <ListBox x:Name="FunctionsList"
                                 Style="{StaticResource CleanListBox}"
                                 ItemContainerStyle="{StaticResource PickerItemStyle}"
                                 ItemTemplate="{StaticResource PickerItemTemplate}"
                                 MouseDoubleClick="List_DoubleClick"
                                 SelectionChanged="List_SelectionChanged"/>
                    </StackPanel>

                    <!-- Apps section -->
                    <StackPanel x:Name="AppsSectionPanel" Margin="0,14,0,0">
                        <TextBlock Text="APPS" FontSize="9" FontWeight="Bold"
                                   Foreground="#253040" Margin="4,0,0,4"
                                   />

                        <!-- Open / Close tab row -->
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="OpenTab" Grid.Column="0" Content="Open"
                                          Style="{StaticResource AppTabStyle}"
                                          IsChecked="True" Click="OpenTab_Click"/>
                            <ToggleButton x:Name="CloseTab" Grid.Column="2" Content="Close"
                                          Style="{StaticResource AppTabStyle}"
                                          Click="CloseTab_Click"/>
                        </Grid>

                        <ListBox x:Name="AppsList"
                                 Style="{StaticResource CleanListBox}"
                                 ItemContainerStyle="{StaticResource PickerItemStyle}"
                                 ItemTemplate="{StaticResource PickerItemTemplate}"
                                 MouseDoubleClick="List_DoubleClick"
                                 SelectionChanged="List_SelectionChanged"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
